# Supabase — Auth real (cadastro, login, recuperação de senha)
# Sem estas variáveis o app continua no modo demonstração (demo123).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# URL pública do app (links de confirmação / reset no e-mail)
NEXT_PUBLIC_SITE_URL=https://olomitutu.vercel.app

# Etapa 3 — persistência remota do Jogo (Supabase como fonte de verdade).
# Deixe desligado (ou ausente) para manter o demo local da Etapa 2 isolado.
# Ative somente em staging DEPOIS de aplicar migrations 030 e 031 manualmente.
# NEXT_PUBLIC_JOGO_REMOTE=1

# Nunca exponha service role no frontend (precisa para sync Google se cliente marcar horário)
# SUPABASE_SERVICE_ROLE_KEY=

# Google Calendar (App → Google) — OAuth do Pai de Santo
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://olomitutu.vercel.app/api/google/callback

# Web Push — Conversas + fluxo de Jogo (Pai e visitante opt-in)
# Gere com: npx web-push generate-vapid-keys
# Sem estas variáveis o app/e-mail seguem; push responde skipped.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:seu-email@dominio.com
# Aplique migration 032_jogo_push.sql manualmente antes de usar push de Jogo em staging.

# E-mail de comprovante de mensalidade (Resend)
# RESEND_API_KEY=re_...
# EMAIL_FROM=Olomitutu <noreply@seudominio.com>
